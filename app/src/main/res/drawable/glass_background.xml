<?xml version="1.0" encoding="utf-8"?>
<!--
  Simulación pedagógica de Glassmorphism (estilo iPhone).
  Para un efecto real de desenfoque se suelen usar librerías como Blurry o RenderScript,
  pero aquí lo haremos con capas de color semi-transparente y gradientes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Color de fondo semi-transparente (Blanco con 40% opacidad aprox) -->
    <solid android:color="#99FFFFFF" />

    <!-- Bordes redondeados amplios estilo iOS -->
    <corners android:radius="24dp" />

    <!-- Borde sutil para acentuar el efecto de cristal -->
    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />
</shape>
